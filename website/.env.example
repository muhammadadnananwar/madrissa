# Public website (React + Vite). Copy to .env and adjust.

# Base URL of the website API on the Django backend.
# Development: leave as /api/site (Vite proxies /api and /media to BACKEND_URL).
# Production:  https://api.your-domain.com/api/site  (and add the website origin to CORS_ALLOWED_ORIGINS)
VITE_API_URL=/api/site

# Management portal (Astro app) — "Student Portal" / "Staff Login" links point here.
VITE_PORTAL_URL=http://localhost:4322

# Django backend used by the dev proxy.
BACKEND_URL=http://localhost:8000
