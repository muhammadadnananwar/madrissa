DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4322
FRONTEND_URL=http://localhost:4322
TIME_ZONE=Asia/Karachi
# PostgreSQL (docker compose up -d db)
POSTGRES_DB=madrasa
POSTGRES_USER=madrasa
POSTGRES_PASSWORD=madrasa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Live classes: jitsi (free, default) | google_meet | zoom
LIVE_CLASS_DEFAULT_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si
# true when using your own Jitsi server (allows embedding inside the portal)
JITSI_EMBED=false
# Google Meet (free with any Google account) - OAuth client + refresh token with calendar.events scope
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email (console backend by default)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
