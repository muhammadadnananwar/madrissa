---
import Blank from "../layouts/Blank.astro";
---
<Blank title="Choose a new password">
  <div class="auth-form" style="min-height:100vh">
    <form class="card" id="f">
      <h1>Choose a new password</h1>
      <div id="msg" class="alert hidden"></div>
      <div class="field"><label for="p1">New password</label><input id="p1" type="password" minlength="6" required /></div>
      <div class="field"><label for="p2">Repeat password</label><input id="p2" type="password" minlength="6" required /></div>
      <button class="btn primary" type="submit">Update password</button>
    </form>
  </div>
  <script>
    import { api } from "../lib/api";
    const q = new URLSearchParams(location.search);
    const f = document.getElementById("f") as HTMLFormElement;
    f.addEventListener("submit", async (e) => {
      e.preventDefault();
      const msg = document.getElementById("msg")!;
      const p1 = (document.getElementById("p1") as HTMLInputElement).value, p2 = (document.getElementById("p2") as HTMLInputElement).value;
      if (p1 !== p2) { msg.className = "alert bad"; msg.textContent = "Passwords do not match."; return; }
      try {
        const r = await api("auth/password-reset/confirm/", { method: "POST", auth: false, body: { uid: q.get("uid"), token: q.get("token"), new_password: p1 } });
        msg.className = "alert good"; msg.innerHTML = `${r.detail} <a href="/login">Sign in</a>`;
      } catch (e: any) { msg.className = "alert bad"; msg.textContent = e.message; }
    });
  </script>
</Blank>
