---
import Portal from "../layouts/Portal.astro";
---
<Portal title="Notifications">
  <div class="page-head"><div><h1>Notifications</h1></div><button id="all" class="btn">Mark all as read</button></div>
  <div class="card flush" id="list"><div class="spinner"></div></div>
  <script>
    import { get, post } from "../lib/api";
    import { ready } from "../lib/shell";
    import { busy, clear, empty, fmtDateTime, h } from "../lib/ui";
    const list = document.getElementById("list")!;
    let page = 1;
    async function load() {
      const d = await get("notifications/", { page });
      if (!d.results.length) return clear(list, empty("No notifications."));
      clear(list, h("ul", { class: "list", style: { padding: "0 1rem" } }, d.results.map((n: any) => h("li", { style: { opacity: n.is_read ? 0.6 : 1 } },
        h("div", {}, h("strong", {}, n.title), n.body ? h("div", { class: "muted small" }, n.body) : null, h("div", { class: "small muted" }, fmtDateTime(n.created_at))),
        h("div", { class: "row" }, n.link ? h("a", { class: "btn sm", href: n.link, onclick: () => post(`notifications/${n.id}/read/`) }, "Open") : null,
          !n.is_read ? h("button", { class: "btn sm ghost", onclick: async () => { await post(`notifications/${n.id}/read/`); load(); } }, "Mark read") : null)))),
        h("div", { class: "pager" }, h("span", {}, `${d.count} total`), h("div", { class: "row" },
          h("button", { class: "btn sm", disabled: !d.previous, onclick: () => { page--; load(); } }, "‹"), h("button", { class: "btn sm", disabled: !d.next, onclick: () => { page++; load(); } }, "›"))));
    }
    document.getElementById("all")!.addEventListener("click", (e: any) => busy(e.currentTarget, () => post("notifications/read_all/")).then(load));
    ready.then(load);
  </script>
</Portal>
