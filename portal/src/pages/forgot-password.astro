---
import Blank from "../layouts/Blank.astro";
---
<Blank title="Forgot password">
  <div class="auth-form" style="min-height:100vh">
    <form class="card" id="f">
      <h1>Reset password</h1>
      <p class="muted">Enter the email registered with the madrasa. We'll send you a reset link. If you have no email on record, contact the office.</p>
      <div id="msg" class="alert hidden"></div>
      <div class="field"><label for="e">Email</label><input id="e" type="email" required /></div>
      <button class="btn primary" type="submit">Send reset link</button>
      <p class="small"><a href="/login">← Back to sign in</a></p>
    </form>
  </div>
  <script>
    import { api } from "../lib/api";
    const f = document.getElementById("f") as HTMLFormElement;
    f.addEventListener("submit", async (e) => {
      e.preventDefault();
      const msg = document.getElementById("msg")!;
      try {
        const r = await api("auth/password-reset/", { method: "POST", auth: false, body: { email: (document.getElementById("e") as HTMLInputElement).value } });
        msg.className = "alert good"; msg.textContent = r.detail;
      } catch (e: any) { msg.className = "alert bad"; msg.textContent = e.message; }
    });
  </script>
</Blank>
