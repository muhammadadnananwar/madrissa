---
import Portal from "../layouts/Portal.astro";
---
<Portal title="Calendar">
  <div class="gc-toolbar">
    <div class="gc-nav">
      <button class="btn" id="today" title="Today (T)">Today</button>
      <button class="btn ghost gc-arrow" id="prev" aria-label="Previous (K)" title="Previous (K)">‹</button>
      <button class="btn ghost gc-arrow" id="next" aria-label="Next (J)" title="Next (J)">›</button>
      <div class="gc-titles"><h1 id="title">Calendar</h1><div id="subtitle" class="small muted"></div></div>
    </div>
    <div class="gc-actions">
      <div class="gc-views" role="group" aria-label="Calendar view">
        <button type="button" data-view="month" title="Month (M)">Month</button>
        <button type="button" data-view="week" title="Week (W)">Week</button>
        <button type="button" data-view="day" title="Day (D)">Day</button>
        <button type="button" data-view="agenda" title="Agenda (A)">Agenda</button>
      </div>
      <button class="btn primary hidden" id="cal-create" title="Create (C)">＋ Create</button>
    </div>
  </div>
  <div id="cal-layers" class="gc-layers" aria-label="Show or hide calendars"></div>
  <div class="card flush gc-card"><div id="cal"><div class="spinner"></div></div></div>
  <p class="small muted gc-hint">Click a day or time to add. Click an item to view, edit or delete it, or drag it to move it.
    Shortcuts: <kbd>T</kbd> today · <kbd>J</kbd>/<kbd>K</kbd> next/previous · <kbd>M</kbd> <kbd>W</kbd> <kbd>D</kbd> <kbd>A</kbd> views · <kbd>C</kbd> create.</p>
  <script>
    import { mountCalendar } from "../lib/calendar";
    import { ready } from "../lib/shell";
    ready.then(mountCalendar);
  </script>
</Portal>
